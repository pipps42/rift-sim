{
  "name": "riftbound-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Riftbound TCG - Backend engine + Frontend React app",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @riftbound/backend dev",
    "dev:frontend": "pnpm --filter @riftbound/frontend dev",
    "start": "pnpm --filter @riftbound/backend start",
    "play": "pnpm --filter @riftbound/backend play",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"packages/**/*.{ts,tsx}\"",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @riftbound/backend db:generate",
    "db:migrate": "pnpm --filter @riftbound/backend db:migrate",
    "db:seed": "pnpm --filter @riftbound/backend db:seed",
    "db:studio": "pnpm --filter @riftbound/backend db:studio",
    "db:reset": "pnpm --filter @riftbound/backend db:reset"
  },
  "keywords": [
    "tcg",
    "riftbound",
    "league-of-legends",
    "card-game",
    "simulator",
    "monorepo"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
